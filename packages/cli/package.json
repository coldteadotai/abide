{
  "name": "@coldtea/abide",
  "version": "0.0.7",
  "description": "Enforce your own AGENTS.md rules on every edit a coding agent makes.",
  "license": "MIT",
  "author": "Coldtea AI",
  "type": "module",
  "bin": {
    "abide": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "opencode",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/rm.mjs dist skills && tsc -p tsconfig.build.json && node ../../scripts/copy.mjs ../../skills/abide-compile/SKILL.md skills/abide-compile/SKILL.md",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "3",
    "@coldtea/abide-schema": "workspace:*",
    "ai": "^7.0.105",
    "diff": "9.0.0",
    "ink": "6.8.0",
    "ink-spinner": "5.0.0",
    "picomatch": "4.0.7",
    "react": "19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/diff": "8.0.0",
    "@types/node": "^22",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}

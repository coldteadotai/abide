{
  "name": "@coldtea/abide-schema",
  "version": "0.0.5",
  "description": "The Abide contract: the rubric document a coding agent compiles from a repository's instruction files, and the verdict a check returns.",
  "license": "MIT",
  "author": "Coldtea AI",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "json-schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/rm.mjs dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
